{
  // Build on Cmd+S, always from main.tex using the repo's .latexmkrc
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "latexmk (latexmkrc)",
  // Only main.tex can be the root (otherwise it may pick a chapter at startup)
  "latex-workshop.latex.search.rootFiles.include": ["main.tex"],
  "latex-workshop.latex.rootFile.useSubFile": false,
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "files.autoSave": "off",

  // Overleaf-style PDF preview in a tab to the right, kept in sync after each build
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
  "latex-workshop.synctex.afterBuild.enabled": true,

  // Show errors in the Problems panel without popping up the log
  "latex-workshop.message.error.show": false
}
